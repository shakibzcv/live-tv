<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>" dir="<%= (typeof currentLang !== 'undefined' && currentLang === 'ar') ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <%
    let pageTitle = "LiveTV — Watch 18,400+ Free Live TV Channels Worldwide";
    let pageDesc = "Watch 18,400+ free live TV channels from 200+ countries directly in your browser. Fast HLS streaming with in-browser player and integrated TV guide schedules.";
    if (typeof initialView !== 'undefined') {
      if (initialView === 'player' && typeof defaultCountry !== 'undefined' && defaultCountry.name) {
        pageTitle = `Live TV Player — Watch ${defaultCountry.name} TV Channels Online | LiveTV`;
        pageDesc = `Stream live television channels from ${defaultCountry.name} free online with high-definition video playback on LiveTV.`;
      } else if (initialView === 'countries') {
        pageTitle = "Explore 200+ Countries Live TV Catalog — LiveTV";
        pageDesc = "Browse live television broadcasts from over 200 countries worldwide. Filter by region, language, and stream count.";
      } else if (initialView === 'channels') {
        pageTitle = "Channels Directory — 18,400+ Live Television Feeds | LiveTV";
        pageDesc = "Search and filter over 18,400+ live television channels by country, genre, news, sports, movies, and broadcast resolution.";
      }
    }
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="keywords" content="live tv, free live tv, watch live tv online, iptv streaming, tv streams, epg guide, world live tv, news channels, sports live tv, free television, hls player">
  <meta name="author" content="LiveTV">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow">

  <!-- Color Scheme & Theme Color for Mobile Browsers -->
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">

  <!-- Mobile & PWA App Metas -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="LiveTV">
  <meta name="application-name" content="LiveTV">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">

  <!-- Open Graph / Social Previews (Discord, Facebook, WhatsApp, Telegram) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="LiveTV">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="/app_demo/dark.png">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta property="og:image:alt" content="LiveTV - Free Worldwide Live TV Streaming Platform">
  <meta property="og:locale" content="<%= (typeof currentLang !== 'undefined' && currentLang) ? currentLang : 'en' %>">

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <meta name="twitter:image" content="/app_demo/dark.png">
  <meta name="twitter:image:alt" content="LiveTV - Free Worldwide Live TV Streaming Platform">

  <!-- Schema.org JSON-LD Structured Data for Google Rich Results -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "LiveTV",
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript. Requires HTML5 Video / HLS support.",
    "description": "Free, open-source live television streaming platform covering 18,400+ channels from 200+ countries with in-browser HLS playback and guide schedules.",
    "screenshot": "/app_demo/dark.png",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "18,400+ Free Live TV Channels",
      "200+ Countries Worldwide",
      "In-Browser HLS Streaming Player",
      "Real-time EPG Program Guide",
      "Dark and Light Themes",
      "Multi-Language Support (8+ Languages & RTL)"
    ]
  }
  </script>

  <!-- Prevent Theme Flash -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('livetv_theme');
        var theme = savedTheme ? savedTheme : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/css/style.css?v=1.3.0">
  <!-- HLS.js for in-browser live streaming -->
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
</head>
<body data-initial-view="<%= typeof initialView !== 'undefined' ? initialView : 'overview' %>" data-current-lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>">

  <!-- TOP SUPPORT BANNER -->
  <div class="support-banner">
    <div class="page-shell">
      <p data-i18n="banner_text">LiveTV — Worldwide Live TV Streaming & EPG Guide Platform</p>
    </div>
  </div>

  <!-- SITE HEADER -->
  <header class="site-header" id="site-header">
    <div class="page-shell">
      <div class="header-brand-nav">
        <a class="brand-wrap" href="/" data-nav="overview" aria-label="LiveTV Home">
          <svg class="brand-logo" width="92" height="34" viewBox="0 0 92 34" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="nav-ruby-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff3366" />
                <stop offset="60%" stop-color="#e11d48" />
                <stop offset="100%" stop-color="#b91c1c" />
              </linearGradient>
              <filter id="nav-live-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#e11d48" flood-opacity="0.6"/>
              </filter>
            </defs>
            <!-- "Live" Typography in Serif (adapts to Light/Dark) -->
            <text x="2" y="24" font-family="'IBM Plex Serif', Georgia, serif" font-weight="700" font-size="22" fill="currentColor" letter-spacing="-0.02em">Live</text>
            <!-- Glowing Ruby Pill Badge with "TV" -->
            <rect x="52" y="7" width="36" height="20" rx="5" fill="url(#nav-ruby-grad)" filter="url(#nav-live-glow)"/>
            <text x="70" y="21.5" font-family="'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif" font-weight="800" font-size="12" fill="#ffffff" text-anchor="middle" letter-spacing="0.05em">TV</text>
          </svg>
        </a>

        <!-- Main Navigation Links (Desktop) -->
        <nav class="main-nav" aria-label="Main Navigation">
          <button type="button" class="nav-link <%= (typeof initialView === 'undefined' || initialView === 'overview') ? 'active' : '' %>" data-nav="overview" data-i18n="nav_overview">Overview</button>
          <button type="button" class="nav-link <%= (typeof initialView !== 'undefined' && initialView === 'countries') ? 'active' : '' %>" data-nav="countries" data-i18n="nav_countries">Countries</button>
          <button type="button" class="nav-link <%= (typeof initialView !== 'undefined' && initialView === 'player') ? 'active' : '' %>" data-nav="player" data-i18n="nav_player">TV Player</button>
          <button type="button" class="nav-link <%= (typeof initialView !== 'undefined' && initialView === 'channels') ? 'active' : '' %>" data-nav="channels" data-i18n="nav_channels">Channels</button>
        </nav>
      </div>

      <!-- Header Actions -->
      <div class="header-actions">
        <div class="lang-dropdown-wrapper" id="lang-dropdown-wrapper">
          <button type="button" class="lang-select-btn" id="lang-btn" title="Choose language" aria-expanded="false" aria-label="Choose language">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span id="current-lang-text"><%=
              currentLang === 'bn' ? 'বাংলা' :
              currentLang === 'es' ? 'Español' :
              currentLang === 'de' ? 'Deutsch' :
              currentLang === 'fr' ? 'Français' :
              currentLang === 'hi' ? 'हिन्दी' :
              currentLang === 'ar' ? 'العربية' :
              'English'
            %></span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="lang-chevron">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="lang-dropdown-menu" id="lang-dropdown-menu">
            <button type="button" class="lang-option-btn<%= currentLang === 'en' ? ' active' : '' %>" data-lang="en">
              <span class="lang-flag">🇬🇧</span>
              <span class="lang-name">English</span>
              <span class="lang-code">EN</span>
            </button>
            <button type="button" class="lang-option-btn<%= currentLang === 'bn' ? ' active' : '' %>" data-lang="bn">
              <span class="lang-flag">🇧🇩</span>
              <span class="lang-name">বাংলা</span>
              <span class="lang-code">BN</span>
            </button>
            <button type="button" class="lang-option-btn<%= currentLang === 'es' ? ' active' : '' %>" data-lang="es">
              <span class="lang-flag">🇪🇸</span>
              <span class="lang-name">Español</span>
              <span class="lang-code">ES</span>
            </button>
            <button type="button" class="lang-option-btn<%= currentLang === 'de' ? ' active' : '' %>" data-lang="de">
              <span class="lang-flag">🇩🇪</span>
              <span class="lang-name">Deutsch</span>
              <span class="lang-code">DE</span>
            </button>
            <button type="button" class="lang-option-btn<%= currentLang === 'fr' ? ' active' : '' %>" data-lang="fr">
              <span class="lang-flag">🇫🇷</span>
              <span class="lang-name">Français</span>
              <span class="lang-code">FR</span>
            </button>
            <button type="button" class="lang-option-btn<%= currentLang === 'hi' ? ' active' : '' %>" data-lang="hi">
              <span class="lang-flag">🇮🇳</span>
              <span class="lang-name">हिन्दी</span>
              <span class="lang-code">HI</span>
            </button>
            <button type="button" class="lang-option-btn<%= currentLang === 'ar' ? ' active' : '' %>" data-lang="ar">
              <span class="lang-flag">🇸🇦</span>
              <span class="lang-name">العربية</span>
              <span class="lang-code">AR</span>
            </button>
          </div>
        </div>

        <!-- Theme Toggle Button (Light/Dark) -->
        <button type="button" class="icon-btn theme-toggle-btn" id="btn-theme-toggle" title="Switch to Light mode" aria-label="Toggle theme">
          <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <!-- Quick TV Player Button -->
        <button type="button" class="icon-btn header-player-btn" id="btn-quick-player" title="Launch TV Player" aria-label="Launch TV Player" data-nav="player">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="20" height="14" x="2" y="3" rx="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </button>

        <!-- Mobile Menu Toggle Button (Hamburger) -->
        <button type="button" class="icon-btn mobile-menu-btn" id="btn-mobile-menu" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
          <svg class="hamburger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg class="close-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

      </div>
    </div>

    <!-- MOBILE NAVIGATION DRAWER (Minimal, full width) -->
    <nav class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation" aria-hidden="true">
      <div class="mobile-nav-links">
        <button type="button" class="mobile-nav-link <%= (typeof initialView === 'undefined' || initialView === 'overview') ? 'active' : '' %>" data-nav="overview">
          <span class="mobile-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </span>
          <span class="mobile-nav-text" data-i18n="nav_overview">Overview</span>
        </button>
        <button type="button" class="mobile-nav-link <%= (typeof initialView !== 'undefined' && initialView === 'countries') ? 'active' : '' %>" data-nav="countries">
          <span class="mobile-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </span>
          <span class="mobile-nav-text" data-i18n="nav_countries">Countries</span>
        </button>
        <button type="button" class="mobile-nav-link <%= (typeof initialView !== 'undefined' && initialView === 'player') ? 'active' : '' %>" data-nav="player">
          <span class="mobile-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </span>
          <span class="mobile-nav-text" data-i18n="nav_player">TV Player</span>
        </button>
        <button type="button" class="mobile-nav-link <%= (typeof initialView !== 'undefined' && initialView === 'channels') ? 'active' : '' %>" data-nav="channels">
          <span class="mobile-nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          </span>
          <span class="mobile-nav-text" data-i18n="nav_channels">Channels</span>
        </button>
      </div>
    </nav>
  </header>

  <main>
    <!-- ==========================================
         VIEW 1: OVERVIEW (HOME)
         ========================================== -->
    <div id="view-overview" class="view-pane <%= (typeof initialView === 'undefined' || initialView === 'overview') ? 'active' : '' %>">
      <!-- HERO -->
      <section class="hero-section">
        <div class="page-shell">
          <p class="section-kicker" data-i18n="hero_kicker">Global Live TV Streaming</p>
          <h1 class="hero-title" data-i18n="hero_title">Watch Live TV From Across The Globe</h1>
          <p class="hero-subhead" data-i18n="hero_subhead">
            Stream over 18,400 live television channels directly in your browser across 200+ countries. Filter by genre, search instantly, and watch live broadcasts with integrated guide schedules.
          </p>

          <div class="hero-cta-group">
            <button type="button" class="btn-primary" data-nav="player" data-i18n="btn_launch_player">Launch TV Player</button>
            <button type="button" class="btn-secondary" data-nav="countries" data-i18n="btn_explore_countries">Explore Countries</button>
          </div>

          <!-- Stats Counters -->
          <dl class="stats-dl-row">
            <div class="stat-col">
              <p class="stat-label" data-i18n="stat_live_channels">Live Channels</p>
              <p class="stat-val"><%= stats.totalChannels ? stats.totalChannels.toLocaleString() : '18,493' %></p>
            </div>
            <div class="stat-col">
              <p class="stat-label" data-i18n="stat_countries_covered">Countries Covered</p>
              <p class="stat-val"><%= stats.streamingCountries || 202 %></p>
            </div>
            <div class="stat-col">
              <p class="stat-label" data-i18n="stat_tv_genres">TV Genres</p>
              <p class="stat-val">27</p>
            </div>
          </dl>
        </div>
      </section>

      <!-- SECTIONS -->
      <div class="page-shell content-body">
        <!-- Section: Country Feeds -->
        <section>
          <div class="section-head">
            <div>
              <h2 class="section-title" data-i18n="overview_browse_title">Browse by Country</h2>
              <p class="section-desc" data-i18n="overview_browse_desc">Pick a country and jump directly into its live TV channels inside the TV Player.</p>
            </div>
            <button type="button" class="link-arrow" data-nav="countries">
              Show all <%= countries.length %> countries &rarr;
            </button>
          </div>

          <!-- Featured Top 9 Countries Grid -->
          <div class="cards-grid">
            <% 
              // Top prominent countries with active channels matching LiveTV layout
              const topCodes = ['US', 'IN', 'RU', 'BR', 'CN', 'DE', 'ES', 'IT', 'CA', 'FR', 'MX', 'AR'];
              const featuredCountries = [];
              topCodes.forEach(code => {
                const found = countries.find(c => c.code.toUpperCase() === code);
                if (found && found.channelCount > 0) featuredCountries.push(found);
              });
              // Fill remaining if needed from countries with active channels
              countries.forEach(c => {
                if (featuredCountries.length < 12 && c.channelCount > 0 && !featuredCountries.some(f => f.code === c.code)) {
                  featuredCountries.push(c);
                }
              });
            %>
            <% featuredCountries.forEach(function(c) { %>
              <article class="country-card" data-country-code="<%= c.code %>">
                <div class="card-top-row">
                  <div class="card-identity">
                    <div class="flag-box">
                      <img src="https://flagcdn.com/w80/<%= (c.flagCode || (c.code.toLowerCase() === 'uk' ? 'gb' : c.code.toLowerCase())) %>.png" alt="<%= c.name %>" class="country-flag-img" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                      <span class="flag-fallback" style="display:none;"><%= c.flag || c.code %></span>
                    </div>
                    <div class="card-titles">
                      <h3 class="card-name" title="<%= c.name %>"><%= c.name %></h3>
                      <p class="card-meta"><%= c.code %> &middot; <%= c.channelCount.toLocaleString() %> channels</p>
                    </div>
                  </div>
                  <span class="epg-badge">LIVE</span>
                </div>

                <p class="card-updated"><%= c.channelCount.toLocaleString() %> channels available</p>

                <div class="card-actions-row">
                  <button type="button" class="action-link btn-quick-play-country" data-country="<%= c.code %>" title="Watch live channels">Watch Live TV</button>
                  <span class="action-dot">&middot;</span>
                  <button type="button" class="action-link btn-view-details" data-code="<%= c.code %>" data-name="<%= c.name %>" data-flag="<%= c.flag %>" data-count="<%= c.channelCount %>">Details</button>
                </div>
              </article>
            <% }); %>
          </div>
        </section>

        <!-- Section: Start Watching -->
        <section>
          <div class="callout-card">
            <p class="callout-text" data-i18n="callout_text">
              Over 18,400 live channels across 202 countries — all free, all streaming directly in your browser. No app, no subscription, no downloads required.
            </p>
            <button type="button" class="btn-primary" data-nav="player" data-i18n="btn_start_watching">
              Start Watching Now &rarr;
            </button>
          </div>
        </section>
      </div>
    </div>

    <!-- ==========================================
         VIEW 2: ALL COUNTRIES
         ========================================== -->
    <div id="view-countries" class="view-pane <%= (typeof initialView !== 'undefined' && initialView === 'countries') ? 'active' : '' %>">
      <div class="page-shell">
        <div class="view-header">
          <h1 class="view-title" data-i18n="countries_title">All countries</h1>
          <p class="view-subhead"><%= countries.length %> regions — click any country to stream its live channels.</p>
        </div>

        <div class="search-filter-bar">
          <input type="text" id="countries-search-input" class="filter-search-input" data-i18n-placeholder="countries_search_placeholder" placeholder="Search countries by name or ISO code (e.g., Germany, US, Brazil)..." autocomplete="off">
        </div>

        <div class="cards-grid" id="all-countries-grid" style="margin-bottom: 4rem;">
          <% countries.forEach(function(c) { %>
            <article class="country-card country-grid-item<%= c.channelCount === 0 ? ' country-card--inactive' : '' %>" data-code="<%= c.code %>" data-name="<%= c.name.toLowerCase() %>">
              <div class="card-top-row">
                <div class="card-identity">
                  <div class="flag-box">
                    <img src="https://flagcdn.com/w80/<%= (c.flagCode || (c.code.toLowerCase() === 'uk' ? 'gb' : c.code.toLowerCase())) %>.png" alt="<%= c.name %>" class="country-flag-img" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="flag-fallback" style="display:none;"><%= c.flag || c.code %></span>
                  </div>
                  <div class="card-titles">
                    <h3 class="card-name" title="<%= c.name %>"><%= c.name %></h3>
                    <p class="card-meta"><%= c.code %></p>
                  </div>
                </div>
                <% if (c.channelCount > 0) { %>
                  <span class="epg-badge">LIVE</span>
                <% } else { %>
                  <span class="epg-badge epg-badge--none">NO FEED</span>
                <% } %>
              </div>

              <p class="card-updated"><%= c.channelCount.toLocaleString() %> channel<%= c.channelCount !== 1 ? 's' : '' %> available</p>

              <div class="card-actions-row">
                <% if (c.channelCount > 0) { %>
                  <button type="button" class="action-link btn-quick-play-country" data-country="<%= c.code %>">Watch Live TV</button>
                  <span class="action-dot">&middot;</span>
                <% } %>
                <button type="button" class="action-link btn-view-details" data-code="<%= c.code %>" data-name="<%= c.name %>" data-flag="<%= c.flag %>" data-count="<%= c.channelCount %>">Details</button>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </div>



    <!-- ==========================================
         VIEW 4: TV PLAYER (LIVE STUDIO)
         ========================================== -->
    <div id="view-player" class="view-pane <%= (typeof initialView !== 'undefined' && initialView === 'player') ? 'active' : '' %>">
      <div class="page-shell">
        <div class="player-studio-wrap">
          <!-- Sidebar: Countries & Channel Selector -->
          <aside class="player-sidebar">
            <div class="sidebar-top">
              <label for="player-country-select" style="font-size:0.75rem; font-family:var(--font-mono); color:var(--muted-foreground); text-transform:uppercase;" data-i18n="player_country_label">Country Region</label>
              
              <!-- Country Select with Flag -->
              <div class="country-select-row">
                <div class="country-flag-badge-box">
                  <img src="https://flagcdn.com/w40/<%= (defaultCountry.flagCode || (defaultCountry.code.toLowerCase() === 'uk' ? 'gb' : defaultCountry.code.toLowerCase())) %>.png" alt="<%= defaultCountry.name %>" class="country-flag-img-mini" id="player-country-flag-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                  <span class="country-flag-fallback" id="player-country-flag-fallback" style="display:none;"><%= defaultCountry.code %></span>
                </div>
                <select id="player-country-select" class="sidebar-country-select">
                  <% countries.forEach(function(c) { %>
                    <option value="<%= c.code %>" data-flag="<%= c.flag %>" data-flag-code="<%= c.flagCode || (c.code.toLowerCase() === 'uk' ? 'gb' : c.code.toLowerCase()) %>" data-name="<%= c.name %>" <%= c.code === defaultCountry.code ? 'selected' : '' %>>
                      <%= c.name %> (<%= c.channelCount %>)
                    </option>
                  <% }); %>
                </select>
              </div>

              <!-- Standard Player Search Bar -->
              <div class="player-search-wrapper">
                <svg class="search-input-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="player-channel-search" class="player-search-input" placeholder="Search channels..." autocomplete="off" spellcheck="false">
                <button type="button" id="player-search-clear" class="search-clear-btn" title="Clear search" aria-label="Clear search" style="display:none;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>

              <!-- Categories Filter (Structured in-place grid, no horizontal overflow or scroll) -->
              <div class="categories-panel">
                <div class="categories-panel-header">
                  <span class="categories-panel-title" data-i18n="player_categories_label">Categories</span>
                  <span class="categories-selected-pill" id="categories-active-badge" data-i18n="cat_all">All</span>
                </div>
                <div class="category-tags-grid" id="category-tags-container">
                  <button type="button" class="cat-tag-btn active" data-category="all" data-i18n="cat_all">All</button>
                  <% categories.forEach(function(cat) { 
                     const catName = typeof cat === 'string' ? cat : (cat.name || cat);
                     const catKey = 'cat_' + catName.toLowerCase().replace(/[^a-z0-9]/g, '');
                  %>
                    <button type="button" class="cat-tag-btn" data-category="<%= catName %>" data-i18n="<%= catKey %>"><%= catName %></button>
                  <% }); %>
                </div>
              </div>
            </div>

            <div class="sidebar-channel-list" id="player-channels-list">
              <% initialChannels.forEach(function(ch, idx) { 
                 const logo = ch.logoUrl || ch.logo || '';
                 const url = ch.streamUrl || ch.url || '';
                 const quality = ch.resolution || ch.quality || 'HD';
                 const category = ch.category || (ch.categories && ch.categories[0]) || 'General';
              %>
                <div class="channel-item <%= idx === 0 ? 'active' : '' %>"
                     data-id="<%= ch.id %>"
                     data-url="<%= url %>"
                     data-name="<%= ch.name %>"
                     data-logo="<%= logo %>"
                     data-quality="<%= quality %>"
                     data-country="<%= ch.country %>"
                     data-category="<%= category %>">
                  <div class="ch-logo-mini">
                    <% if (logo) { %>
                      <img src="<%= logo %>" alt="<%= ch.name %>" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                      <span style="display:none;"><%= ch.name.substring(0, 2).toUpperCase() %></span>
                    <% } else { %>
                      <span><%= ch.name.substring(0, 2).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <div class="ch-meta-mini">
                    <div class="ch-title-mini"><%= ch.name %></div>
                    <div class="ch-sub-mini"><%= quality %> &middot; <%= category %></div>
                  </div>
                </div>
              <% }); %>
            </div>
          </aside>

          <!-- Main Stage: Video + Live EPG -->
          <div class="player-main-stage">
            <div class="video-wrapper" id="video-player-wrapper">
              <video id="video-element" playsinline></video>

              <!-- Video Overlay State -->
              <div id="video-overlay" class="video-overlay">
                <div class="spinner"></div>
                <span id="video-status-text" data-i18n="player_status_connecting">Connecting to live feed...</span>
              </div>

              <!-- Custom Live TV Control Bar (Mute, Volume, CC, Fullscreen) -->
              <div class="custom-player-controls" id="custom-player-controls">
                <div class="controls-left">
                  <!-- Mute / Unmute Button -->
                  <button type="button" class="ctrl-btn" id="ctrl-mute-btn" title="Mute / Unmute (m)">
                    <svg id="icon-volume-high" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                      <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                    </svg>
                    <svg id="icon-volume-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <line x1="23" y1="9" x2="17" y2="15"></line>
                      <line x1="17" y1="9" x2="23" y2="15"></line>
                    </svg>
                  </button>

                  <!-- Minimal Volume Slider -->
                  <div class="volume-slider-box">
                    <div class="volume-track-wrap">
                      <div class="volume-track-bg"></div>
                      <div class="volume-track-fill" id="volume-track-fill" style="width: 100%;"></div>
                      <input type="range" id="ctrl-volume-slider" min="0" max="1" step="0.05" value="1" title="Volume" class="ctrl-slider" aria-label="Volume">
                    </div>
                  </div>
                </div>

                <div class="controls-right">
                  <!-- CC / Subtitle Toggle (Visible only when stream has subtitle tracks) -->
                  <button type="button" class="ctrl-btn ctrl-cc-btn" id="ctrl-cc-btn" title="Toggle Subtitles" style="display:none;">
                    <span class="cc-badge-text">CC</span>
                  </button>

                  <!-- Fullscreen Button -->
                  <button type="button" class="ctrl-btn" id="ctrl-fullscreen-btn" title="Toggle Fullscreen (f)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <!-- Current Channel Header Bar -->
            <% const firstCh = initialChannels[0]; %>
            <div class="ch-now-bar">
              <div class="ch-now-info">
                <div>
                  <h2 id="current-ch-name" class="ch-now-name"><%= firstCh ? firstCh.name : 'Select a Channel' %></h2>
                  <div class="ch-now-meta">
                    <span id="current-ch-quality" class="epg-badge" style="background:var(--surface-muted); color:var(--foreground);"><%= firstCh ? (firstCh.resolution || firstCh.quality || 'HD') : 'HD' %></span>
                    <span id="current-ch-country">
                      <img src="https://flagcdn.com/w40/<%= (defaultCountry.flagCode || (defaultCountry.code.toLowerCase() === 'uk' ? 'gb' : defaultCountry.code.toLowerCase())) %>.png" alt="" class="now-country-flag" style="width:16px; height:12px; vertical-align:middle; margin-right:4px; border-radius:1px; object-fit:cover;">
                      <span><%= defaultCountry.name %></span>
                    </span>
                  </div>
                </div>
              </div>

              <div class="ch-controls-group">
                <button type="button" class="btn-secondary" id="btn-reload-stream" style="height:34px; font-size:0.8125rem;">Reload</button>
              </div>
            </div>

            <!-- Electronic Program Guide Display Card -->
            <div class="epg-display-card">
              <div class="epg-label-row">
                <span data-i18n="player_now_playing_heading">Now Playing &middot; Live Broadcast Schedule</span>
              </div>

              <div>
                <h3 id="epg-programme-title" class="epg-current-title">Fetching programme schedule...</h3>
                <div id="epg-programme-time" style="font-family:var(--font-mono); font-size:0.8125rem; color:var(--muted-foreground); margin-top:0.25rem;">--:-- - --:--</div>
                <p id="epg-programme-desc" style="font-size:0.875rem; color:var(--muted-foreground); margin-top:0.5rem; line-height:1.5;">Programme description will appear when available.</p>

                <div class="epg-progress-track">
                  <div id="epg-progress-bar" class="epg-progress-bar"></div>
                </div>
              </div>

              <div style="border-top: 1px solid var(--border); padding-top: 0.75rem;">
                <div style="font-family:var(--font-mono); font-size:0.75rem; color:var(--muted-foreground); text-transform:uppercase; margin-bottom:0.5rem;">Upcoming Broadcasts</div>
                <div id="epg-upcoming-list" class="upcoming-list">
                  <div style="font-size:0.8125rem; color:var(--muted-foreground);">No upcoming schedule available.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==========================================
         VIEW 5: CHANNELS DIRECTORY
         ========================================== -->
    <div id="view-channels" class="view-pane <%= (typeof initialView !== 'undefined' && initialView === 'channels') ? 'active' : '' %>">
      <div class="page-shell">
        <div class="view-header">
          <h1 class="view-title" data-i18n="channels_title">Channels directory</h1>
          <p class="view-subhead" data-i18n="channels_subhead">Explore live channels filtered by country and genre.</p>
        </div>

        <!-- Filter Bar -->
        <div class="ch-dir-filter-bar">
          <div class="ch-dir-search-wrap">
            <svg class="ch-dir-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="channels-dir-search" class="ch-dir-search-input" placeholder="Search channels by name, category..." autocomplete="off">
          </div>
          <select id="channels-dir-country" class="ch-dir-select">
            <option value="">All Countries</option>
            <% countries.forEach(function(c) { %>
              <% if (c.channelCount > 0) { %>
                <option value="<%= c.code %>"><%= c.name %> (<%= c.channelCount %>)</option>
              <% } %>
            <% }); %>
          </select>
          <select id="channels-dir-category" class="ch-dir-select">
            <option value="">All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }); %>
          </select>
        </div>

        <p class="ch-dir-count" id="ch-dir-count"><%= initialChannels.length %> channels</p>

        <div class="cards-grid ch-dir-grid" id="channels-directory-grid" style="margin-bottom: 4rem;">
          <% initialChannels.forEach(function(ch) {
             const logo = ch.logoUrl || ch.logo || '';
             const url = ch.streamUrl || ch.url || '';
             const quality = ch.resolution || ch.quality || 'HD';
             const category = ch.category || (ch.categories && ch.categories[0]) || 'General';
          %>
            <article class="country-card channel-dir-card"
              data-name="<%= ch.name.toLowerCase() %>"
              data-category="<%= category.toLowerCase() %>"
              data-country="<%= (ch.country || '').toLowerCase() %>">
              <div class="card-top-row">
                <div class="card-identity">
                  <div class="ch-logo-box">
                    <% if (logo) { %>
                      <img src="<%= logo %>" alt="<%= ch.name %>" loading="lazy" onerror="this.parentElement.innerHTML='📺';">
                    <% } else { %>
                      📺
                    <% } %>
                  </div>
                  <div class="card-titles">
                    <h3 class="card-name" title="<%= ch.name %>"><%= ch.name %></h3>
                    <p class="card-meta"><%= quality %> &middot; <%= category %></p>
                  </div>
                </div>
                <span class="epg-badge">LIVE</span>
              </div>

              <div class="channel-dir-country">
                <img src="https://flagcdn.com/w40/<%= (ch.country || 'us').toLowerCase() === 'uk' ? 'gb' : (ch.country || 'us').toLowerCase() %>.png" alt="<%= ch.country %>" onerror="this.style.display='none';">
                <span><%= ch.country || 'Unknown' %></span>
              </div>

              <div class="ch-dir-actions">
                <button type="button" class="btn-primary btn-play-channel-dir"
                  data-id="<%= ch.id %>"
                  data-url="<%= url %>"
                  data-name="<%= ch.name %>"
                  data-country="<%= ch.country %>"
                  data-i18n="btn_play_in_tv">Play in TV</button>
                <button type="button" class="btn-secondary btn-copy-channel-stream"
                  data-url="<%= url %>">Copy URL</button>
              </div>
            </article>
          <% }); %>
        </div>

        <!-- Channels Empty State -->
        <div id="channels-dir-empty" class="ch-dir-empty" style="display: none;">
          <div class="ch-dir-empty-icon">📺</div>
          <h3 class="ch-dir-empty-title" data-i18n="ch_empty_title">No channels found</h3>
          <p class="ch-dir-empty-desc" data-i18n="ch_empty_desc">No channels match your search and filter criteria. Try adjusting your query or resetting filters.</p>
          <button type="button" id="btn-reset-ch-filters" class="btn-secondary" style="margin-top: 1rem;">Reset filters</button>
        </div>
      </div>
    </div>
  </main>

  <!-- ==========================================
       SITE FOOTER (LiveTV Footer)
       ========================================== -->
  <footer class="site-footer">
    <div class="page-shell footer-main">
      <div>
        <p class="footer-brand">LiveTV</p>
        <p class="footer-desc">
          Free, open-source live TV streaming platform for 200+ countries.
        </p>
      </div>

      <div>
        <p class="footer-col-title" data-i18n="footer_col_resources">Resources</p>
        <ul class="footer-links">
          <li><a class="footer-link" href="#" data-nav="overview">Overview</a></li>
          <li><a class="footer-link" href="#" data-nav="countries">Countries</a></li>
          <li><a class="footer-link" href="#" data-nav="player">TV Player</a></li>
          <li><a class="footer-link" href="#" data-nav="channels">Channels</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-col-title" data-i18n="footer_col_project">Project</p>
        <ul class="footer-links">
          <li><a class="footer-link" href="https://github.com/shakibzcv/live-tv" target="_blank" rel="noopener">GitHub</a></li>
          <li><a class="footer-link" href="https://github.com/shakibzcv/live-tv/blob/main/LICENSE" target="_blank" rel="noopener">License</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="page-shell">
        <p>&copy; <%= new Date().getFullYear() %> LiveTV &middot; Open Source TV Streaming & EPG Infrastructure</p>
        <p>LiveTV v1.0 &middot; 18,493 Channels &middot; 202 Countries</p>
      </div>
    </div>
  </footer>

  <!-- ==========================================
       MODALS & DIALOGS
       ========================================== -->
  <!-- Country Details Modal -->
  <div id="country-details-modal" class="modal-overlay">
    <div class="modal-dialog">
      <div class="modal-head">
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <div class="flag-box" style="width:36px; height:24px;">
            <img id="modal-country-flag-img" src="" alt="" class="country-flag-img">
            <span id="modal-country-flag" style="display:none; font-size:1.2rem;"></span>
          </div>
          <h2 id="modal-country-title" class="modal-title" data-i18n="modal_details_title">Country Details</h2>
        </div>
        <button type="button" class="modal-close-btn" id="btn-close-country-modal">&times;</button>
      </div>
      <div class="modal-body">
        <p id="modal-country-channel-count" style="font-size:0.875rem; color:var(--muted-foreground); margin-bottom:1rem;"></p>
        <div style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:0.5rem;">
          <button type="button" class="btn-primary" id="btn-modal-watch-country" data-i18n="modal_btn_watch">Watch Live TV &rarr;</button>
        </div>
      </div>
    </div>
  </div>



  <!-- Toast Notification -->
  <div id="toast" class="toast-msg">Copied to clipboard</div>

  <!-- Client Application Script -->
  <script src="/js/i18n.js?v=1.1.8"></script>
  <script src="/js/app.js?v=1.1.8"></script>
</body>
</html>
